{
  "name": "stackprice",
  "version": "0.1.0",
  "description": "AWS CDK infrastructure pricing estimation CLI — know what it costs before you deploy",
  "keywords": [
    "aws",
    "cdk",
    "aws-cdk",
    "cost",
    "pricing",
    "infrastructure",
    "finops",
    "cloudformation",
    "cli",
    "devops"
  ],
  "author": {
    "name": "Suneel Sristi",
    "url": "https://github.com/suneelsristi"
  },
  "license": "MIT",
  "homepage": "https://github.com/suneelsristi/stackprice#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suneelsristi/stackprice.git"
  },
  "bugs": {
    "url": "https://github.com/suneelsristi/stackprice/issues"
  },
  "bin": {
    "stackprice": "dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "test": "vitest run --coverage",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest watch",
    "lint": "eslint src/ tests/ --ext .ts",
    "format": "prettier --write src/ tests/",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "@vitest/coverage-v8": "^4.1.1",
    "esbuild": "^0.27.4",
    "eslint": "^10.1.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.1"
  },
  "dependencies": {
    "@aws-sdk/client-pricing": "^3.1023.0",
    "@aws-sdk/credential-providers": "^3.1023.0",
    "chalk": "^4.1.2",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3",
    "env-paths": "^4.0.0"
  }
}
